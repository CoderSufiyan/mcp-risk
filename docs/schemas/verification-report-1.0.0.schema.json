{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/CoderSufiyan/mcp-risk/main/docs/schemas/verification-report-1.0.0.schema.json",
  "title": "mcp-risk verification report",
  "description": "A version-pinned static verification report for an npm package or GitHub repository.",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "scanner",
    "target",
    "artifact",
    "metadata",
    "policy",
    "summary",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "scanner": {
      "$ref": "#/$defs/scanner"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "oneOf": [
        { "$ref": "#/$defs/npmArtifact" },
        { "$ref": "#/$defs/githubArtifact" }
      ]
    },
    "metadata": {
      "type": "object"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "oneOf": [
    {
      "properties": {
        "artifact": { "$ref": "#/$defs/npmArtifact" },
        "metadata": { "$ref": "#/$defs/npmMetadata" }
      }
    },
    {
      "properties": {
        "artifact": { "$ref": "#/$defs/githubArtifact" },
        "metadata": { "$ref": "#/$defs/githubMetadata" }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "scanner": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "mcp-risk" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sha256Digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "gitSha1Digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "git-sha1" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      },
      "additionalProperties": false
    },
    "npmArtifact": {
      "type": "object",
      "required": ["kind", "name", "version", "tarballUrl", "digest"],
      "properties": {
        "kind": { "const": "npm" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "tarballUrl": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256Digest" }
      },
      "additionalProperties": false
    },
    "githubArtifact": {
      "type": "object",
      "required": ["kind", "owner", "repository", "repositoryUrl", "requestedRef", "commit", "digest"],
      "properties": {
        "kind": { "const": "github" },
        "owner": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "repositoryUrl": { "type": "string", "minLength": 1 },
        "requestedRef": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "digest": { "$ref": "#/$defs/gitSha1Digest" }
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "specifier": { "type": "string" },
        "type": { "enum": ["dependency", "optional", "peer", "bundled"] }
      },
      "additionalProperties": false
    },
    "npmMetadata": {
      "type": "object",
      "required": ["maintainers", "dependencies", "installScripts", "tarballSizeBytes", "sourceFileCount"],
      "properties": {
        "publishedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "maintainers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependency" }
        },
        "installScripts": {
          "type": "array",
          "items": { "enum": ["preinstall", "install", "postinstall"] }
        },
        "license": { "type": "string" },
        "repository": { "type": "string" },
        "tarballSizeBytes": { "type": "integer", "minimum": 0 },
        "sourceFileCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": ["path", "dependencies", "installScripts"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "installScripts": {
          "type": "array",
          "items": { "enum": ["preinstall", "install", "postinstall"] }
        }
      },
      "additionalProperties": false
    },
    "githubMetadata": {
      "type": "object",
      "required": ["archiveUrl", "archiveDigest", "archiveSizeBytes", "sourceFileCount", "manifests"],
      "properties": {
        "archiveUrl": { "type": "string", "minLength": 1 },
        "archiveDigest": { "$ref": "#/$defs/sha256Digest" },
        "archiveSizeBytes": { "type": "integer", "minimum": 0 },
        "sourceFileCount": { "type": "integer", "minimum": 0 },
        "manifests": {
          "type": "array",
          "items": { "$ref": "#/$defs/manifest" }
        }
      },
      "additionalProperties": false
    },
    "policyViolation": {
      "type": "object",
      "required": ["id", "message"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["status", "violations"],
      "properties": {
        "status": { "enum": ["not-configured", "passed", "failed"] },
        "name": { "type": "string", "minLength": 1 },
        "violations": {
          "type": "array",
          "items": { "$ref": "#/$defs/policyViolation" }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["score", "grade", "critical", "high", "medium", "low"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "grade": { "enum": ["A", "B", "C", "D", "F"] },
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "title", "message", "location", "recommendation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "title": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "recommendation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
